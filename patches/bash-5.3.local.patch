--- bash-5.3.orig/general.c	2025-06-25 21:54:35.000000000 +0200
+++ bash-5.3/general.c	2026-10-10 20:32:33.359432476 +0200
@@ -595,6 +595,27 @@
   return 0;
 }
 
+int
+sh_setnodelay (int fd)
+{
+  int flags;
+
+  if ((flags = fcntl (fd, F_GETFL, 0)) < 0)
+    return -1;
+
+  /* This is defined to O_NDELAY in filecntl.h if O_NONBLOCK is not present
+     and O_NDELAY is defined. */
+#ifdef O_NONBLOCK
+  flags |= O_NONBLOCK;
+#endif
+
+#ifdef O_NDELAY
+  flags |= O_NDELAY;
+#endif
+
+  return (fcntl (fd, F_SETFL, flags));
+}
+
 /* Just a wrapper for the define in include/filecntl.h */
 int
 sh_setclexec (int fd)
