: ${PKG_EXPAT_HOST_SHA256SUM:=3ad89b8588e6644bd4e49981480d48b21289eebbcd4f0a1a4afb1c29f99b6ab4};
: ${PKG_EXPAT_HOST_VERSION:=2.8.2};
: ${PKG_EXPAT_HOST_URL:=https://github.com/libexpat/libexpat/releases/download/R_${PKG_EXPAT_HOST_VERSION//./_}/expat-${PKG_EXPAT_HOST_VERSION}.tar.xz};
: ${PKG_EXPAT_HOST_CONFIGURE_ARGS_EXTRA:="--without-docbook"};
: ${PKG_EXPAT_HOST_CONFIGURE_TYPE:="autotools"};
: ${PKG_EXPAT_HOST_LDFLAGS_CONFIGURE:="-Wl,-rpath,${PREFIX}/lib"};

ex_pkg_register "expat_host" "${RTL_FILEOP_SOURCE_FNAME}" "host_deps";

