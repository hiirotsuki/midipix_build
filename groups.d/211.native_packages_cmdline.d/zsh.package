: ${PKG_ZSH_DEPENDS:="libiconv ncurses ncursesw"};
: ${PKG_ZSH_SHA256SUM:=36fa734374b44783582cec09bcd67822e2f992c779ec1624ab5596df078d2f81};
: ${PKG_ZSH_VERSION:=5.9.2};
: ${PKG_ZSH_URL:=https://www.zsh.org/pub/zsh-${PKG_ZSH_VERSION}.tar.xz};
: ${PKG_ZSH_CONFIG_CACHE_EXTRA:="zsh_cv_sys_elf=no
zsh_cv_shared_tgetent=yes
zsh_cv_shared_environ=yes"};
: ${PKG_ZSH_CONFIGURE_ARGS_EXTRA:="--enable-libc-musl --mandir=/usr/share/man --infodir=/usr/share/info --sysconfdir=/etc --enable-etcdir=/etc/zsh --enable-multibyte --enable-function-subdirs --enable-zsh-secure-free --with-tcsetpgrp --enable-dynamic=no"};
: ${PKG_ZSH_IN_TREE:=1};

ex_pkg_register "zsh" "${RTL_FILEOP_SOURCE_FNAME}" "native_packages";

